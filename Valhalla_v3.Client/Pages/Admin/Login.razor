@using System.Net.Http.Headers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using Valhalla_v3.Client.Helpers
@using Valhalla_v3.Client.Service
@inject NavigationManager navigation
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@rendermode InteractiveAuto
@attribute [AllowAnonymous]
<h2>Logowanie</h2>

<EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="test">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="Nazwafloating" class="form-label" >Nazwa</label>
        <InputText type="text" class="form-control" id="Nazwafloating" @bind-Value="@loginModel.Username"/>
        <ValidationMessage For="@(() => loginModel.Username)" />
    </div>
    <div class="mb-3">
        <label for="Nazwafloating" class="form-label">Hasło</label>
        <InputText type="password" class="form-control" id="Passwordfloating" @bind-Value="@loginModel.Password" />
    </div>
    <button class="btn btn-outline-success w-100" type="submit">Zaloguj</button>
</EditForm>
@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color:red;">@errorMessage</p>
}

